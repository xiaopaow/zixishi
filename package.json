{
  "name": "qishi-focus-room",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build:web": "node scripts/clean-dist.mjs && tsc -b && vite build",
    "build": "pnpm build:web && node scripts/prepare-sites.mjs",
    "android:assets": "node scripts/prepare-android-assets.mjs && capacitor-assets generate --android",
    "android:sync": "pnpm build:web && cap sync android",
    "android:open": "cap open android",
    "android:signing": "node scripts/setup-android-signing.mjs",
    "android:beta": "pnpm android:sync && node scripts/build-android.mjs --release",
    "android:debug": "pnpm android:sync && node scripts/build-android.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@capacitor/android": "8.4.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.4.2",
    "@capacitor/filesystem": "8.1.2",
    "@capacitor/local-notifications": "8.2.1",
    "@capacitor/share": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@supabase/supabase-js": "^2.110.9",
    "dexie": "^4.4.4",
    "lucide-react": "^1.27.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.0",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^28.0.0",
    "sharp": "0.32.6",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.27.0"
}
